<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AarxMaps.Core</PackageId>
    <Description>Core library for AarxMaps, a .NET SDK for Google Maps APIs. Provides shared HTTP infrastructure, dependency injection integration, and core abstractions used by feature modules like Places and Routes.</Description>
    <PackageTags>google-maps;googlemaps;maps-api;dotnet;aspnetcore;sdk;api-client;httpclient;dependency-injection;geospatial;location;mapping</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

</Project>
